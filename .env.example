# GEMINI_API_KEY: Optional if using AI features. Not required for core database operation.
GEMINI_API_KEY=""

# MONGODB_URI: MongoDB connection string for local VS Code or remote MongoDB Atlas deployment
# Example: mongodb://localhost:27017/college_erp or mongodb+srv://username:password@cluster.mongodb.net/college_erp
MONGODB_URI="mongodb://localhost:27017/college_erp"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens for user authentication
JWT_SECRET="studynet_college_erp_jwt_secret_key_2026"

# PORT: Application server port (const PORT = process.env.PORT || 3000;)
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY_KEY_ID: Razorpay Key ID for Test/Sandbox Mode (e.g. rzp_test_xxxxxxxxxxxxxx)
RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Razorpay Key Secret for Test/Sandbox Mode
RAZORPAY_KEY_SECRET=""

